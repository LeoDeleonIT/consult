# Provider choices: openai, aws, or fixture. Never expose provider secrets to browser code.
AI_PROVIDER=openai

# Change this to a long random value before any shared deployment.
AUTH_SECRET=replace-with-at-least-32-random-characters

# Real provider settings.
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
SUMMARY_MODEL=gpt-5.6-terra

# Test-only escape hatch. Fixture mode ignores audio and returns fixed sample data.
ALLOW_FIXTURE_PROCESSING=false

AUDIO_STORAGE_DRIVER=r2
AUDIO_RETENTION_DAYS=30
MAX_RECORDING_MINUTES=90
MAX_UPLOAD_MB=25
APP_URL=http://localhost:3000

# Default guardrail: false shows a warning, blocks Open Dental, and requires SYN-/TEST-/DEMO- references.
# Do not set true until the legal, BAA, privacy, security, retention, and production-readiness approvals are complete.
PHI_PRODUCTION_APPROVED=false
ENABLE_DEVELOPMENT_SEED_USERS=true

# AWS mode: set AI_PROVIDER=aws and AUDIO_STORAGE_DRIVER=aws together.
AWS_REGION=us-east-1
AWS_API_BASE_URL=
AWS_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_TRANSCRIBE_MODE=standard
AWS_TRANSCRIBE_LANGUAGE_CODE=en-US
AWS_TRANSCRIBE_MAX_SPEAKERS=2
AWS_TRANSCRIBE_VOCABULARY_NAME=
# A server-only value matching the generated AWS Secrets Manager bridge secret; minimum 32 characters.
AWS_BRIDGE_TOKEN_SECRET=
# Comma-separated application origins for deployment validation; wildcard origins are forbidden.
AWS_ALLOWED_ORIGINS=

# Open Dental bridge. Both keys remain server-only. The office must enable the API and run eConnector.
OPEN_DENTAL_DEVELOPER_KEY=
OPEN_DENTAL_CUSTOMER_KEY=
OPEN_DENTAL_API_BASE_URL=https://api.opendental.com/api/v1
